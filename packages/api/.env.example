# Product OS API environment variables
# Copy to packages/api/.env and fill in what you need.

# Required for local boot
DATABASE_URL=postgresql://product_os:product_os@localhost:5434/product_os
JWT_SECRET=change-me-in-local-dev
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Recommended for encrypting user-provided provider keys and OAuth tokens
DATA_ENCRYPTION_KEY=change-me-too

# Optional runtime
PORT=3001
UPLOAD_DIR=./uploads
CODE_AGENT_DAILY_LIMIT=3

# Optional AI provider defaults
# Leave these blank if you prefer to add keys per user in Settings.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional sandbox/runtime features
# When unset, Flow code/review runs fall back to the local sandbox.
E2B_API_KEY=
PUBLIC_DEMO_MODE=false
PUBLIC_DEMO_ENABLED_INTEGRATIONS=
PUBLIC_DEMO_INTERNAL_EMAILS=
PUBLIC_DEMO_INTERNAL_USER_IDS=

# Optional auth / OAuth state secrets
GOOGLE_OAUTH_STATE_SECRET=
INTEGRATION_STATE_SECRET=

# Optional Google sign-in
# Register http://localhost:3001/api/auth/google/callback in your Google OAuth app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google Workspace data integration
# Register http://localhost:3001/api/integrations/callback/google in your Google OAuth app.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/callback/google

# Optional Jira data integration
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3001/api/integrations/callback/jira

# Optional Slack data integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/integrations/callback/slack

# Optional Notion data integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3001/api/integrations/callback/notion

# Optional Airtable data integration
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
AIRTABLE_REDIRECT_URI=http://localhost:3001/api/integrations/callback/airtable

# Optional Intercom data integration
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
INTERCOM_REDIRECT_URI=http://localhost:3001/api/integrations/callback/intercom

# Optional Salesforce data integration
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:3001/api/integrations/callback/salesforce
