# Local development — uses Neon hosted PostgreSQL
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
PORT=3001
JWT_SECRET=your-secret-key-here
UPLOAD_DIR=./uploads
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/callback/google
NOTION_REDIRECT_URI=http://localhost:3001/api/integrations/callback/notion
# Daily run cap for Flow @Code agent (public users)
CODE_AGENT_DAILY_LIMIT=3
