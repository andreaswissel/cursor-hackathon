{
  "identifier": "default",
  "description": "Default permissions for the Product OS desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "fs:allow-read-text-file",
    "fs:allow-exists"
  ]
}
